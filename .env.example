APP_NAME="Hotel Alpenhof"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# File, not database, and for two reasons. The install wizard needs a
# session to remember which step you are on — before it has created a
# database to keep sessions in. And on SQLite every request would
# otherwise write to the same file the booking engine is trying to lock
# (§6), which is contention on the one write path that must not have any.
# Pinned, because Laravel otherwise derives the session cookie name from
# APP_NAME — so renaming the hotel would silently log everybody out,
# including whoever was half way through the install wizard.
SESSION_COOKIE=doba_session
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true in production (HTTPS-only cookies). Left null, Laravel decides
# from the request scheme — explicit is safer once TLS is terminated by
# the proxy.
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Doba — per-hotel settings
#
# Only what a developer sets at install time lives here. Anything a hotelier
# should be able to change themselves — address, phone, policies, texts,
# colours, images, room descriptions — belongs in the database and is edited
# in the admin panel.
###############################################################################

DOBA_THEME=default
DOBA_CURRENCY=EUR
DOBA_TIMEZONE=Europe/Berlin

# First entry is the default locale. Adding one here does not translate the
# content — the admin panel's completeness indicator is what tracks that.
# The languages this hotel serves, first one is the default. Doba ships
# en, de, fr, nl, uk and pl — listing a language here needs its lang/
# directory, and the install wizard sets this from the language chosen
# on its first screen.
DOBA_LOCALES=en,de,fr,nl

# Serve the default locale without a URL prefix (/rooms instead of /en/rooms).
# The prefixed form then permanently redirects, so no page has two URLs.
DOBA_HIDE_DEFAULT_PREFIX=false

DOBA_CHECKIN_FROM=15:00
DOBA_CHECKOUT_UNTIL=11:00

# --- SEO ---------------------------------------------------------------------
# Set true on staging and demo installs. Emits noindex site-wide AND
# Disallow: / in robots.txt, so the two can never disagree — which is how a
# demo site ends up outranking the hotel it demonstrates.
DOBA_NOINDEX=false
# DOBA_OG_IMAGE=branding/og-default.jpg
# DOBA_TWITTER_SITE=@alpenhof
DOBA_SCHEMA_TYPE=Hotel
DOBA_PRICE_RANGE="€€"

# --- Features ----------------------------------------------------------------
FEATURE_PAYMENT=true
FEATURE_DEPOSIT_ONLY=true
FEATURE_OTA_SYNC=false
FEATURE_PROMO=true
FEATURE_EXTRAS=true
FEATURE_REVIEWS=false

# --- Payments ----------------------------------------------------------------
# stripe | paypal | liqpay | coinbase | manual
# "manual" = bank transfer / pay on arrival: bookings confirm without online
# payment. Every configured provider's /webhooks/<name> endpoint stays live
# regardless of which one is the default.
PAYMENT_GATEWAY=manual

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# Leave on when this install owns the domain it answers on. Turn it off for
# a preview or demo under someone else's wildcard host, where HSTS with
# includeSubDomains would set policy for a domain that is not yours.
DOBA_HSTS=true

# Backups: how many sets to keep, whether to archive uploaded photos with
# the database, and when the nightly run happens. Empty DOBA_BACKUP_AT
# disables the schedule.
DOBA_BACKUP_KEEP=10
DOBA_BACKUP_UPLOADS=true
DOBA_BACKUP_AT=03:15

# City tax (Kurtaxe / Ortstaxe / taxe de séjour), per person per night in
# minor units — 250 is €2.50. Shown on its own line at checkout and on
# the invoice, outside VAT. 0 = no municipal tax here. Most
# municipalities exempt children; set the flag to false where yours
# taxes every age.
DOBA_CITY_TAX=0
DOBA_CITY_TAX_CHILDREN_EXEMPT=true

# Lifecycle mail: "we look forward to you" N days before arrival (0
# switches it off) and a thank-you the morning after departure. Neither
# sends until outgoing mail is confirmed in Admin → Mail.
DOBA_MAIL_PRE_ARRIVAL_DAYS=3
DOBA_MAIL_POST_STAY=true

# Months after a guest's last checkout before their profile is
# anonymised unasked. Invoices and booking amounts stay; the person
# goes. 0 switches the retention clock off.
DOBA_RETENTION_MONTHS=24
