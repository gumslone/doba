APP_NAME="Hotel Alpenhof"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Doba — per-hotel settings
#
# Only what a developer sets at install time lives here. Anything a hotelier
# should be able to change themselves — address, phone, policies, texts,
# colours, images, room descriptions — belongs in the database and is edited
# in the admin panel.
###############################################################################

DOBA_THEME=default
DOBA_CURRENCY=EUR
DOBA_TIMEZONE=Europe/Berlin

# First entry is the default locale. Adding one here does not translate the
# content — the admin panel's completeness indicator is what tracks that.
DOBA_LOCALES=en,de,fr,nl

# Serve the default locale without a URL prefix (/rooms instead of /en/rooms).
# The prefixed form then permanently redirects, so no page has two URLs.
DOBA_HIDE_DEFAULT_PREFIX=false

DOBA_CHECKIN_FROM=15:00
DOBA_CHECKOUT_UNTIL=11:00

# --- SEO ---------------------------------------------------------------------
# Set true on staging and demo installs. Emits noindex site-wide AND
# Disallow: / in robots.txt, so the two can never disagree — which is how a
# demo site ends up outranking the hotel it demonstrates.
DOBA_NOINDEX=false
# DOBA_OG_IMAGE=branding/og-default.jpg
# DOBA_TWITTER_SITE=@alpenhof
DOBA_SCHEMA_TYPE=Hotel
DOBA_PRICE_RANGE="€€"

# --- Features ----------------------------------------------------------------
FEATURE_PAYMENT=true
FEATURE_DEPOSIT_ONLY=true
FEATURE_OTA_SYNC=false
FEATURE_PROMO=true
FEATURE_EXTRAS=true
FEATURE_REVIEWS=false
